{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>timo-reymann/renovate-config"
  ],
  "enabledManagers": [
    "circleci",
    "nuget",
    "github-actions",
    "docker-compose",
    "dockerfile",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts\\/download-rclone\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nRCLONE_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ]
}
