<?xml version="1.0"?>
<interface xmlns="http://zero-install.sourceforge.net/2004/injector/interface" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://zero-install.sourceforge.net/2004/injector/interface https://docs.0install.net/specifications/feed.xsd">
  <name>MothaSync</name>
  <summary>system tray tool that syncs a folder from disk A to disk B</summary>
  <description>MothaSync provides a focused desktop interface for keeping a folder mirrored between two local drives without requiring users to operate rclone directly.</description>
  <homepage>https://github.com/timo-reymann/MothaSync</homepage>
  <category>Utility</category>

  <icon href="https://mothasync.timo-reymann.de/mothasync.png" type="image/png"/>
  <icon href="https://mothasync.timo-reymann.de/mothasync.ico" type="image/vnd.microsoft.icon"/>
  <icon href="https://mothasync.timo-reymann.de/mothasync.icns" type="image/x-icns"/>

  <feed-for interface="https://mothasync.timo-reymann.de/mothasync.xml"/>

  <entry-point binary-name="MothaSync.Client" command="run"/>

  <group>
    <command name="run" path="MothaSync.Client.exe"/>
    <implementation arch="Windows-x86_64" version="{version}" released="{released}">
      <manifest-digest/>
      <archive href="https://github.com/timo-reymann/MothaSync/releases/download/v{version}/mothasync-{version}-win-x64.zip" type="application/zip"/>
    </implementation>
  </group>

  <group>
    <command name="run" path="MothaSync.Client"/>
    <implementation arch="Linux-x86_64" version="{version}" released="{released}">
      <manifest-digest/>
      <archive href="https://github.com/timo-reymann/MothaSync/releases/download/v{version}/mothasync-{version}-linux-x64.zip" type="application/zip"/>
    </implementation>
    <implementation arch="Linux-aarch64" version="{version}" released="{released}">
      <manifest-digest/>
      <archive href="https://github.com/timo-reymann/MothaSync/releases/download/v{version}/mothasync-{version}-linux-arm64.zip" type="application/zip"/>
    </implementation>
  </group>

  <group>
    <command name="run" path="MothaSync.app/Contents/MacOS/MothaSync.Client"/>
    <implementation arch="MacOSX-x86_64" version="{version}" released="{released}">
      <manifest-digest/>
      <archive href="https://github.com/timo-reymann/MothaSync/releases/download/v{version}/mothasync-{version}-osx-x64.zip" type="application/zip"/>
    </implementation>
    <implementation arch="MacOSX-aarch64" version="{version}" released="{released}">
      <manifest-digest/>
      <archive href="https://github.com/timo-reymann/MothaSync/releases/download/v{version}/mothasync-{version}-osx-arm64.zip" type="application/zip"/>
    </implementation>
  </group>
</interface>
