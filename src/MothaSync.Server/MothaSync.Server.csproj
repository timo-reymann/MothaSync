<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- SDK 11 build regression, remove with 11.0.101: https://github.com/dotnet/sdk/issues/56656 -->
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MothaSync.Server.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MothaSync.Shared\MothaSync.Shared.csproj" />
  </ItemGroup>

</Project>
