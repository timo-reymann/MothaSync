<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MothaSync.Client"
             x:Class="MothaSync.Client.App"
             Name="MothaSync"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Resources.axaml" />
                <ResourceInclude Source="/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Theme.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://MothaSync.Client/Assets/Trays/idle.png"
                      ToolTipText="MothaSync"
                      Clicked="OnTrayClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open MothaSync" Click="OnOpen" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static local:AppVersion.MenuHeader}" IsEnabled="False" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="License information" Click="OnLicense" />
                        <NativeMenuItem Header="Exit" Click="OnExit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
