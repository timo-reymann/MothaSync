<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MothaSync.Client.Controls"
             x:Class="MothaSync.Client.Controls.SyncArrow"
             Width="84"
             VerticalAlignment="Center">
    <StackPanel Spacing="6" HorizontalAlignment="Center">
        <c:Icon Data="{StaticResource IconArrow}"
                Size="44"
                StrokeThickness="2.4"
                Foreground="{DynamicResource AppAccent}" />
        <TextBlock Text="SYNC DIRECTION"
                   Classes="muted"
                   FontSize="10"
                   LetterSpacing="0.6"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Width="60" />
    </StackPanel>
</UserControl>
