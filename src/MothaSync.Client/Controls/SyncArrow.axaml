<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MothaSync.Client.Controls.SyncArrow"
             Width="180"
             VerticalAlignment="Center">
    <StackPanel Spacing="6" HorizontalAlignment="Center">
        <Path Width="180"
              Height="24"
              Data="M 4 12 h 164 M 154 4 l 12 8 -12 8"
              Stroke="{DynamicResource AppAccent}"
              StrokeThickness="2.4"
              StrokeLineCap="Round"
              StrokeJoin="Round" />
        <TextBlock Text="SYNC DIRECTION"
                   Classes="muted"
                   FontSize="10"
                   LetterSpacing="0.6"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
