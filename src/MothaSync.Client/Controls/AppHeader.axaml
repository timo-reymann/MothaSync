<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MothaSync.Client.Controls"
             x:Class="MothaSync.Client.Controls.AppHeader">
    <Border BorderBrush="{DynamicResource AppLine}" BorderThickness="0,0,0,1" Padding="20,12">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="HistoryButton" Classes="icon" Click="OnHistory" ToolTip.Tip="History">
                    <c:Icon Data="{StaticResource IconHistory}" />
                </Button>
                <Button x:Name="SettingsButton" Classes="icon" Click="OnSettings" ToolTip.Tip="Settings">
                    <c:Icon Data="{StaticResource IconGear}" />
                </Button>
                <Border Width="1" Height="16" Margin="6,0" Background="{DynamicResource AppLine}" />
                <Button x:Name="MinimizeButton" Classes="icon" Click="OnMinimize" ToolTip.Tip="Minimize">
                    <c:Icon Data="{StaticResource IconMinimize}" />
                </Button>
                <Button Classes="icon close" Click="OnExit" ToolTip.Tip="Close">
                    <c:Icon Data="{StaticResource IconClose}" />
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <c:AppLogo />
                <TextBlock Text="SyncMotha" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Ellipse x:Name="Dot" Classes="dot idle" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
