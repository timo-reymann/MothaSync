<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>MothaSync.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup>
        <CFBundleName>MothaSync</CFBundleName>
        <CFBundleDisplayName>MothaSync</CFBundleDisplayName>
        <CFBundleIdentifier>de.timo_reymann.mothasync</CFBundleIdentifier>
        <CFBundleVersion>1.0.0</CFBundleVersion>
        <CFBundleShortVersionString>1.0.0</CFBundleShortVersionString>
        <CFBundlePackageType>APPL</CFBundlePackageType>
        <CFBundleExecutable>MothaSync.Client</CFBundleExecutable>
        <CFBundleIconFile>MothaSync.icns</CFBundleIconFile>
        <NSHighResolutionCapable>true</NSHighResolutionCapable>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
        <RcloneRid Condition="'$(RcloneRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RcloneRid>
        <RcloneRid Condition="'$(RcloneRid)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</RcloneRid>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/Assets/rclone/$(RcloneRid)')">
        <Content Include="Assets/rclone/$(RcloneRid)/**">
            <Link>rclone\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="DotNet.Bundle" Version="0.9.13"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0"/>
        <PackageReference Include="Avalonia.Labs.Notifications" Version="12.0.2"/>
    </ItemGroup>

    <Target Name="CopyBundleIcon" AfterTargets="BundleApp">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\$(CFBundleIconFile)"
              DestinationFolder="$(PublishDir)$(CFBundleName).app/Contents/Resources"/>
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\MothaSync.Shared\MothaSync.Shared.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MothaSync.Client.Test" />
    </ItemGroup>
</Project>
