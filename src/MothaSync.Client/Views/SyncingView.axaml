<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MothaSync.Client.Controls"
             x:Class="MothaSync.Client.Views.SyncingView">
    <DockPanel>
        <c:AppHeader DockPanel.Dock="Top" />
        <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="20">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <Ellipse Grid.Column="0" Classes="dot run" />
                <TextBlock Grid.Column="1" Text="Syncing…" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="CurrentFile"
                           Grid.Column="2"
                           Classes="muted mono"
                           Text=""
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="PrefixCharacterEllipsis" />
                <Button Grid.Column="3" Classes="sm" Click="OnPause">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon x:Name="PauseIcon" Data="{StaticResource IconPause}" Size="14" />
                        <TextBlock x:Name="PauseLabel" Text="Pause" />
                    </StackPanel>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Spacing="8">
                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="PercentText" Text="0%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatsText"
                               Grid.Column="2"
                               Classes="muted"
                               Text=""
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
            <HeaderedContentControl Grid.Row="2" Theme="{StaticResource LogPanel}">
                <HeaderedContentControl.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="rclone log" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Ellipse Classes="dot ok" Width="6" Height="6" />
                            <TextBlock Classes="muted mono" Text="auto-scroll: on" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </HeaderedContentControl.Header>
                <TextBlock x:Name="LogText" Classes="log" />
            </HeaderedContentControl>
        </Grid>
    </DockPanel>
</UserControl>
