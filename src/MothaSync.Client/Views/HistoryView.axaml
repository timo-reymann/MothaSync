<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MothaSync.Client.Controls"
             xmlns:views="using:MothaSync.Client.Views"
             x:Class="MothaSync.Client.Views.HistoryView">
    <DockPanel>
        <c:AppHeader DockPanel.Dock="Top" Active="History" />
        <StackPanel Margin="24" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Sync history" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="muted" Text="last 10 runs" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <Border BorderBrush="{DynamicResource AppLine}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
                <Grid>
                    <StackPanel x:Name="RunList" Spacing="1" Background="{DynamicResource AppLine}" />
                    <TextBlock x:Name="EmptyState"
                               Text="No sync runs recorded yet."
                               Classes="muted"
                               HorizontalAlignment="Center"
                               Margin="16"
                               IsVisible="False" />
                </Grid>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>