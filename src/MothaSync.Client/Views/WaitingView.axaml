<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="using:MothaSync.Client.Controls"
                x:Class="MothaSync.Client.Views.WaitingView">
    <DockPanel>
        <c:AppHeader DockPanel.Dock="Top" />
        <StackPanel VerticalAlignment="Center" Margin="24" Spacing="24">
            <TextBlock Classes="muted"
                       Text="Waiting for both drives. Sync starts automatically when both are connected and writable, unless the last sync ran less than an hour ago."
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0" Classes="card" Padding="12">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock x:Name="SourceTitle" Text="Drive A" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Image Source="avares://MothaSync.Client/Assets/drive.png" Height="96" Stretch="Uniform" />
                        <TextBlock x:Name="SourcePathText"
                                   Classes="muted mono"
                                   Text="not set"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Ellipse x:Name="SourceDot" Classes="dot" />
                            <TextBlock x:Name="SourceStatusText" Classes="muted" Text="waiting for drive" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <c:SyncArrow Grid.Column="1" />
                <Border Grid.Column="2" Classes="card" Padding="12">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock x:Name="DestinationTitle" Text="Drive B" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Image Source="avares://MothaSync.Client/Assets/drive.png" Height="96" Stretch="Uniform" />
                        <TextBlock x:Name="DestinationPathText"
                                   Classes="muted mono"
                                   Text="not set"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Ellipse x:Name="DestinationDot" Classes="dot" />
                            <TextBlock x:Name="DestinationStatusText" Classes="muted" Text="waiting for drive" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel x:Name="SamePathMessage"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        IsVisible="False">
                <c:Icon Data="{StaticResource IconWarn}" Size="14" Foreground="{DynamicResource AppErr}"
                        VerticalAlignment="Center" />
                <TextBlock Text="Source and destination are the same folder. Change one in Settings."
                           Foreground="{DynamicResource AppErrText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="SyncNowButton"
                        Classes="pri"
                        Content="Sync"
                        HorizontalAlignment="Center"
                        IsVisible="False"
                        Click="OnSyncNow" />
                <TextBlock x:Name="LastSyncText" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
