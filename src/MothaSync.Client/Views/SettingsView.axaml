<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MothaSync.Client.Controls"
             x:Class="MothaSync.Client.Views.SettingsView">
    <DockPanel>
        <c:AppHeader DockPanel.Dock="Top" Status="Idle" Active="Settings" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="24">
            <Button Content="Cancel" Click="OnClose" />
            <Button Classes="pri" Content="Save" Click="OnClose" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="24,24,24,0" Spacing="24">
            <Grid ColumnDefinitions="*,Auto,*">
                <Button Grid.Column="0" Classes="drive sel" Click="OnPickSource">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="muted" Text="DRIVE A · SOURCE" FontSize="11" LetterSpacing="0.8" />
                        <c:Icon Data="{StaticResource IconDrive}"
                                Size="30"
                                HorizontalAlignment="Left"
                                Foreground="{DynamicResource AppAccent}" />
                        <TextBlock Classes="muted mono" Text="/home/partner/3d-school" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Data="{StaticResource IconFolder}" Size="14" Foreground="{DynamicResource AppAccent}" />
                            <TextBlock Classes="muted" Text="click to change folder" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <c:SyncArrow Grid.Column="1" />
                <Button Grid.Column="2" Classes="drive" Click="OnPickDestination">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="muted" Text="DRIVE B · DESTINATION" FontSize="11" LetterSpacing="0.8" />
                        <c:Icon Data="{StaticResource IconDrive}"
                                Size="30"
                                HorizontalAlignment="Left"
                                Foreground="{DynamicResource AppAccent}" />
                        <TextBlock Classes="muted mono" Text="/Volumes/SSD One" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Data="{StaticResource IconFolder}" Size="14" Foreground="{DynamicResource AppAccent}" />
                            <TextBlock Classes="muted" Text="click to change folder" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Classes="muted"
                       Text="Files only flow from A to B. Anything you change on Drive B is overwritten at the next sync."
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="440" />
            <StackPanel Spacing="8">
                <TextBlock Classes="muted" Text="SERVER URL" FontSize="11" LetterSpacing="0.8" />
                <TextBox x:Name="ServerUrl"
                         Text="https://syncmotha.example.com"
                         PlaceholderText="https://…" />
                <TextBlock Classes="muted"
                           Text="Sync metrics and logs are sent to this server. Leave empty to keep them on this device."
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
