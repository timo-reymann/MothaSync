<views:ChromelessWindow xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:views="using:MothaSync.Client.Views"
                          x:Class="MothaSync.Client.Views.MainWindow"
                          Icon="avares://MothaSync.Client/Assets/logo.png"
                          Title="MothaSync">
    <Border BorderBrush="{DynamicResource AppLine}" BorderThickness="1">
        <views:WaitingView />
    </Border>
</views:ChromelessWindow>
