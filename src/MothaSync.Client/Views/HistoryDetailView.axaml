<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MothaSync.Client.Controls"
             x:Class="MothaSync.Client.Views.HistoryDetailView">
    <DockPanel>
        <c:AppHeader DockPanel.Dock="Top" Active="History" />
        <Grid RowDefinitions="Auto,Auto,*" Margin="24" RowSpacing="16">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0" Classes="icon" Click="OnBack" ToolTip.Tip="Back to history">
                    <c:Icon Data="{StaticResource IconBack}" />
                </Button>
                <TextBlock x:Name="DateText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="2" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel Grid.Row="1">
                <Border Classes="pill" Margin="0,4,8,4"><TextBlock x:Name="FilesText" FontSize="13" /></Border>
                <Border Classes="pill" Margin="0,4,8,4"><TextBlock x:Name="SizeText" FontSize="13" /></Border>
                <Border Classes="pill" Margin="0,4,8,4"><TextBlock x:Name="DurationText" FontSize="13" /></Border>
                <Border x:Name="ErrorPill" Classes="pill bad" Margin="0,4,8,4"><TextBlock Text="error" FontSize="13" /></Border>
            </WrapPanel>
            <HeaderedContentControl x:Name="FailedLog" Grid.Row="2" Theme="{StaticResource LogPanel}">
                <HeaderedContentControl.Header>
                    <TextBlock Text="rclone output" />
                </HeaderedContentControl.Header>
                <TextBlock x:Name="FailedLogText" Classes="log"><Run Text="" /></TextBlock>
            </HeaderedContentControl>
            <HeaderedContentControl x:Name="OkLog" Grid.Row="2" Theme="{StaticResource LogPanel}" IsVisible="False">
                <HeaderedContentControl.Header>
                    <TextBlock Text="rclone output" />
                </HeaderedContentControl.Header>
                <TextBlock x:Name="OkLogText" Classes="log"><Run Text="" /></TextBlock>
            </HeaderedContentControl>
        </Grid>
    </DockPanel>
</UserControl>
